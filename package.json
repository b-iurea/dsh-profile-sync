{
  "name": "dsh-profile-sync",
  "version": "0.2.0",
  "description": "Keep DeepSeek Harness providers, plugins and settings aligned between machines over Git or a LAN sidecar.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/index.js",
    "lib/sync.js",
    "lib/lan.js",
    "lib/lan-host.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/b-iurea/dsh-profile-sync"
  },
  "homepage": "https://github.com/b-iurea/dsh-profile-sync#readme",
  "bugs": {
    "url": "https://github.com/b-iurea/dsh-profile-sync/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "profile",
    "sync",
    "lan",
    "backup"
  ]
}
